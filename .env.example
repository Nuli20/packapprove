# Server-only. Obtain from your Supabase project; never use NEXT_PUBLIC_ for these.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Runtime connection: restricted login must be able to SET LOCAL ROLE packapprove_app.
# Run migrations with a separate trusted migration owner; never expose either URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# false in production. Full demo also requires isolated local Supabase on 54321/54322.
NEXT_PUBLIC_DEMO_MODE=false
# true behind production HTTPS
COOKIE_SECURE=true

# Exact public HTTPS origin in production, without trailing slash
# APP_ORIGIN=https://packapprove.example.com
